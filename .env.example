# ============================================
#  rozetxd - Ortam Değişkenleri
#  Bu dosyayı ".env" olarak kopyala ve doldur:
#    cp .env.example .env
#  .env dosyası .gitignore'da, asla paylaşma!
# ============================================

# Discord hesabının user token'ı (ZORUNLU)
TOKEN=buraya_user_tokenini_yaz

# Komut ön eki (varsayılan: .)
PREFIX=.

# Log/bildirim göndereceğimiz Discord webhook URL'i (opsiyonel)
WEBHOOK_URL=

# Sadece bu ID'ler komut kullanabilir. Boş bırakırsan sadece kendi hesabın.
# Birden fazla için virgülle ayır: 123456789,987654321
OWNER_IDS=

# Log seviyesi: debug | info | warn | error
LOG_LEVEL=info

# Sunucuya girince otomatik tarama sonucunun gönderileceği kanal ID'si (opsiyonel).
# Boşsa sonuç WEBHOOK_URL'e gönderilir.
OUTPUT_CHANNEL_ID=
